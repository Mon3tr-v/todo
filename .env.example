POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=todo
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
TODO_JWT_SECRET=replace-with-at-least-32-random-characters
TODO_SERVER_PORT=8080
TODO_MAX_ATTACHMENT_MB=25

# Replace both the key name and the 32-byte secret. Use an external KMS in production.
MINIO_KMS_SECRET_KEY=todo-master-key:0123456789abcdef0123456789abcdef
